# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# ─── Database (matches docker-compose.yml) ────────────────────────────────
DATABASE_URL=postgresql://secondbrain:secondbrain@localhost:5433/second_brain
# Run pending migrations automatically when the server starts
DB_AUTO_MIGRATE=true

# ─── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED: long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# ─── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ─── AI provider ──────────────────────────────────────────────────────────
# "gemini" = real embeddings + LLM (free key: https://aistudio.google.com/apikey)
# "mock"   = offline deterministic provider (no key; extractive answers) for demos/tests
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must match vector(768) in the schema migration
EMBEDDING_DIMENSIONS=768

# ─── RAG tuning ───────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Chunks sent to the LLM after reranking
RAG_TOP_K=6
# Candidates fetched by hybrid search before reranking
RAG_CANDIDATES=24
# Minimum cosine similarity for a semantic match to be considered
RAG_MIN_SIMILARITY=0.3
RAG_RERANK=true
RAG_QUERY_REWRITE=true
RAG_HISTORY_MESSAGES=6

# ─── Background ingestion worker ──────────────────────────────────────────
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1500
