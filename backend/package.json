{
  "name": "second-brain-backend",
  "version": "1.0.0",
  "description": "Second Brain API — RAG-powered personal knowledge base",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --import ./tests/setup.js --test \"tests/unit/*.test.js\"",
    "setup:env": "node scripts/setup-env.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "second-brain": "file:..",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
